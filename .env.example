# --- Required ---
# Groq key from console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Optional ---
# Access token for the app and phone. Leave empty and one is generated into data/token.txt
JARVIS_TOKEN=
USER_NAME=Diego
TIMEZONE=Africa/Dar_es_Salaam
PORT=3000
# Must support tool calling, e.g. llama-3.3-70b-versatile or openai/gpt-oss-120b
JARVIS_MODEL=llama-3.3-70b-versatile
# Use another OpenAI-compatible service by setting these instead
LLM_BASE_URL=
LLM_API_KEY=

# Morning briefing spoken/notified at this local time (24h). Empty = off
BRIEFING_TIME=07:30
WORK_START=09:00
WORK_END=17:00

# Tools that skip the "Approve?" prompt (comma separated). Start empty. Example: AUTO_APPROVE=calendar_delete
AUTO_APPROVE=

# Google (email + calendar): see README step 3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public https address (Railway sets this automatically via RAILWAY_PUBLIC_DOMAIN)
PUBLIC_URL=
# Reliable web search (free tier at tavily.com). Without it Jarvis falls back to a free scraper that may be blocked
TAVILY_API_KEY=

# Telegram bot messaging (optional)
TELEGRAM_BOT_TOKEN=

# Set to 0 on a cloud server: laptop tools act on the machine the server runs on
LAPTOP_TOOLS=1
