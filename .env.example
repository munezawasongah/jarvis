# --- Required: ONE of these AI keys ---
# Free option: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid option (later): https://console.anthropic.com
ANTHROPIC_API_KEY=
# gemini or anthropic. Empty = Gemini if only GEMINI_API_KEY is set, otherwise Anthropic.
JARVIS_PROVIDER=

# --- Optional ---
# Access token for the app and phone. Leave empty and one is generated into data/token.txt
JARVIS_TOKEN=
USER_NAME=Diego
TIMEZONE=Africa/Dar_es_Salaam
PORT=3000
# Empty = gemini-2.5-flash (Gemini) or claude-sonnet-5-5 (Anthropic)
JARVIS_MODEL=

# Morning briefing spoken/notified at this local time (24h). Empty = off
BRIEFING_TIME=07:30
WORK_START=09:00
WORK_END=17:00

# Tools that skip the "Approve?" prompt (comma separated). Start empty. Example: AUTO_APPROVE=calendar_delete
AUTO_APPROVE=

# Google (email + calendar): see README step 3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot messaging (optional)
TELEGRAM_BOT_TOKEN=

# Set to 0 on a cloud server: laptop tools act on the machine the server runs on
LAPTOP_TOOLS=1
