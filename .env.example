# --- Required: ONE AI key (Jarvis uses whichever you set) ---
# Free options:
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys  (use :free models)
MISTRAL_API_KEY=       # https://console.mistral.ai
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
# Paid (best quality):
ANTHROPIC_API_KEY=     # https://console.anthropic.com
# Force one when several keys are set: gemini, groq, openrouter, mistral, cerebras, anthropic, openai
JARVIS_PROVIDER=
# Empty = a sensible default for the provider
JARVIS_MODEL=

# Morning briefing spoken/notified at this local time (24h). Empty = off
BRIEFING_TIME=07:30
WORK_START=09:00
WORK_END=17:00

# Tools that skip the "Approve?" prompt (comma separated). Start empty. Example: AUTO_APPROVE=calendar_delete
AUTO_APPROVE=

# Google (email + calendar): see README step 3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot messaging (optional)
TELEGRAM_BOT_TOKEN=

# Set to 0 on a cloud server: laptop tools act on the machine the server runs on
LAPTOP_TOOLS=1
